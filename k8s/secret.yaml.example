apiVersion: v1
kind: Secret
metadata:
  name: mkjs-secret
  namespace: mkjs
type: Opaque
data:
  # Valores gerados com: echo -n "valor" | base64
  # Em produção, usar o pipeline CD que cria o secret via GitHub Secrets
  POSTGRES_PASSWORD: <base64 da senha>
  DATABASE_URL: <base64 da connection string>
